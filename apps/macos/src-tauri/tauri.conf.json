{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent OS",
  "version": "0.0.0",
  "identifier": "ai.agent-os.desktop",
  "build": {
    "beforeDevCommand": "node_modules/.bin/vite",
    "beforeBuildCommand": "node_modules/.bin/tsc --build && node_modules/.bin/vite build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Agent OS",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Visible",
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "devCsp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["app"],
    "icon": ["icons/icon.png"]
  }
}
