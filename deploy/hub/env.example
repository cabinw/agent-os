# Copy to /etc/agent-os/hub.env, replace every angle-bracket placeholder, then
# set root:root ownership and mode 0600. The deployed file uses this restricted
# NAME=value form; shell expressions and quoted multiline values are forbidden.
HOST=127.0.0.1
PORT=4173
LOG_PATH=/var/lib/agent-os/hub/events.jsonl
AGENT_OS_REMOTE_STATE_PATH=/var/lib/agent-os/hub/remote-placement.json
AGENT_OS_RUNNER_MODE=remote
AGENT_OS_RUNNER_ID=<stable-runner-id>
AGENT_OS_RUNNER_TOKEN=<unique-runner-token-at-least-32-characters>
AGENT_OS_HUMAN_TOKEN=<unique-human-token-at-least-32-characters>
AGENT_OS_AGENT_TOKENS='{"claude":"<unique-claude-token-at-least-32-characters>","grok":"<unique-grok-token-at-least-32-characters>","kimi":"<unique-kimi-token-at-least-32-characters>","codex":"<unique-codex-token-at-least-32-characters>"}'
AGENT_OS_ALLOWED_ORIGINS=https://agent-os.example.invalid
HOP_BUDGET=6
