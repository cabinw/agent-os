{
  "name": "agent-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An AI-native operating system for running teams of autonomous AI agents",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:layers": "node scripts/check-layers.mjs",
    "verify": "tsc --build && biome check . && node scripts/check-layers.mjs && vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
